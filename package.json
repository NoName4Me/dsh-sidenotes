{
  "name": "dsh-sidenotes",
  "version": "0.1.0-dev.4",
  "private": true,
  "description": "Side Chat: ask focused questions alongside any conversation without interrupting it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoName4Me/dsh-sidenotes.git"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.2.3-0"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/check-build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "pnpm build",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.6-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.5 <0.2.3-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.5 <0.2.3-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5"
  },
  "packageManager": "pnpm@11.28.5",
  "icon": "./icon.svg"
}
